{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agenda-salao",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agenda-salao",
      // Criado com `wrangler d1 create agenda-salao`.
      "database_id": "5fcdc5f8-88db-4c43-8f2a-3c50d010fcfb",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [{ "queue": "agenda-mensagens", "binding": "FILA" }],
    "consumers": [
      {
        "queue": "agenda-mensagens",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 2,
        "max_concurrency": 1
      }
    ]
  },
  "ai": { "binding": "AI" },
  "triggers": { "crons": ["0 23 * * *"] },
  "vars": {
    "WHATSAPP_PHONE_NUMBER_ID": "1259114920629517",
    "GRAPH_API_VERSAO": "v26.0",
    "MODELO_CLAUDE": "claude-haiku-4-5",
    "JANELA_INICIO": "08:00",
    "JANELA_FIM": "20:00",
    "HISTORICO_TURNOS": "10",
    "MODELO_RESUMO": "resumo_amanha",
    "MODELO_ALERTA": "alerta_sistema"
  }
}
